# Keep this file on the AWS host. Never commit real keys.
DATA_ROOT=/opt/image-lab/data
BIND_HOST=127.0.0.1
PORT=18080
# start.sh generates this when creating .env; use >=24 random characters if setting it yourself.
API_KEY=
# Obtain gated repository access with this account first, then provide its read token.
# A nonempty HF_TOKEN exported in the invoking shell takes priority over this file.
# Host 'hf auth login' is not passed into Docker. Verify with ./start.sh --check-access.
# When empty, start.sh uses the temporary repository .hf-token.env if present.
HF_TOKEN=
LOAD_TIMEOUT=3600
JOB_TIMEOUT=1800
# Optional complete, authorized local Mage Edit snapshot. It is copied into DATA_ROOT once.
MAGE_LOCAL_PATH=
# Optional: prompt_mode=magic sends prompts to Ideogram's hosted prompt expansion API.
IDEOGRAM_API_KEY=
HIVE_TEXT_MODERATION_KEY=
HIVE_VISUAL_MODERATION_KEY=
